# -----------------------------------------------------------------------------
# MinecraftCloud Production & Development Environment Configuration
# -----------------------------------------------------------------------------

# PostgreSQL Database Connection URL (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://mccloud:mc_cloud_secure_pg_pass_2026@localhost:5432/minecraftcloud?schema=public"

# Authentication & Session Security Key (Minimum 32 random characters)
AUTH_SECRET="minecraftcloud-super-production-secret-token-key-2026-replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Cloud Node Agent & Infrastructure API (Persistent Minecraft Host VM)
# Important: On Vercel, point this to your public persistent VPS/Cloud VM endpoint
CLOUD_API_URL="http://localhost:8443"
CLOUD_API_KEY="minecraftcloud-super-secret-node-key-2026"

# Default Minecraft Host Domain & Public IP
PUBLIC_HOST="play.minecraftcloud.net"

# Node Environment
NODE_ENV="development"
